VITE_ETHERSCAN_API_KEY=

# --- Опционально: базовый URL API Etherscan ---
# Оставьте пустым: в `npm run dev` запросы идут через прокси `/etherscan-api` (см. vite.config).
# Для своего бэкенда/прокси укажите полный URL без завершающего слэша:
# VITE_ETHERSCAN_BASE=https://api.etherscan.io

# Bitcoin (mempool.space) ключей не требует — ничего добавлять не нужно.
